# Copie para .env para sobrescrever os defaults (opcional: tudo funciona sem .env).
# Valores abaixo são EXCLUSIVAMENTE de desenvolvimento local.

# --- Banco (serviço db do docker-compose) ---
POSTGRES_DB=purchase
POSTGRES_USER=purchase
POSTGRES_PASSWORD=purchase
# Porta do Postgres exposta no host
DB_HOST_PORT=5433

# --- Back-end (Spring Boot) ---
# Rodando local (./mvnw spring-boot:run) o back usa localhost:5433
DB_URL=jdbc:postgresql://localhost:5433/purchase
DB_USER=purchase
DB_PASSWORD=purchase
SERVER_PORT=8080
# JWT HS256: mínimo de 32 bytes. Gere um valor próprio fora do ambiente local (ex.: openssl rand -base64 48)
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
JWT_TTL_MINUTES=15
